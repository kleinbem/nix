  "settings": {
    "editor.formatOnSave": true,
    // No system dirs (/nix, /var, browser profiles) as folders: watching them froze the
    // machine, and absolute exclude patterns don't apply per folder.
    "files.watcherExclude": {
      "**/result": true,
      "**/result-*": true,
      "**/.direnv": true
    },
    "files.exclude": {
      "**/.git": true,
      "**/.DS_Store": true,
      "**/*.direnv": true,
      "**/result": true,
      "**/result-*": true,
      "nix-*": true
    },
    "files.associations": {
      "Justfile": "makefile",
      "*.nix": "nix"
    },
    "[nix]": {
      "editor.defaultFormatter": "jnoortheen.nix-ide"
    },
    // nil, not nixd: nixd's option providers eval the full system config in
    // multi-GB workers.
    "nix.enableLanguageServer": true,
    "nix.serverPath": "nil",
    "nix.formatterPath": "nixfmt"
  }
}
