# ---------------------------------------------------------------------------
# Public Nix binary cache for kleinbem/mesh-agents: mesh-agents-cache.kleinbem.dev,
# static files in R2 (nix-cache-info, *.narinfo, nar/*). CI on mesh-agents'
# main pushes the current build with `nix copy` and deletes everything else,
# so the bucket holds one build (~1–3 GB, inside R2's free 10 GB).
#
# Separate from Attic on purpose: Attic is the fleet's private, mesh-only
# cache; nothing here is reachable from or related to it.
#
# Cost bounds (R2 has no spending cap):
#   - storage: one build, CI refuses to push past a size limit
#   - writes: only CI on main
#   - egress: free on R2
#   - reads: the cache rule below serves repeat downloads from Cloudflare's
#     edge, which never reach R2 (no Class B operations)
#
# The CI credentials are minted in r2-tokens/ (scoped to this bucket only)
# and distributed in github-secrets.tf. The signing key is generated by hand
# (`nix key generate-secret --key-name mesh-agents-cache.kleinbem.dev-1`)
# into infra/terraform.yaml; its public half goes in mesh-agents' nixConfig.
# ---------------------------------------------------------------------------

locals {
  mesh_agents_cache_domain = "mesh-agents-cache.kleinbem.dev"

  mesh_agents_cache_lifecycle = {
    rules = [{
      # Mirrors the default rule R2 gives every new bucket (PUT replaces it).
      id                              = "abort-multipart-7d"
      enabled                         = true
      conditions                      = { prefix = "" }
      abortMultipartUploadsTransition = { condition = { type = "Age", maxAge = 7 * 86400 } }
    }]
  }
}

resource "cloudflare_r2_bucket" "mesh_agents_cache" {
  account_id = var.cloudflare_account_id
  name       = "mesh-agents-cache"
}

# The public custom domain and the lifecycle rules: v5-only resources in the
# provider, so via the API as for the backup bucket (cloudflare-r2.tf). The
# custom domain creates its own proxied DNS record in the zone.
resource "terraform_data" "mesh_agents_cache_bucket" {
  triggers_replace = {
    bucket    = cloudflare_r2_bucket.mesh_agents_cache.name
    domain    = local.mesh_agents_cache_domain
    lifecycle = jsonencode(local.mesh_agents_cache_lifecycle)
  }

  provisioner "local-exec" {
    interpreter = ["bash", "-euo", "pipefail", "-c"]
    environment = {
      CF_API_TOKEN  = var.cloudflare_api_token
      CF_ACCOUNT_ID = var.cloudflare_account_id
      ZONE_ID       = data.cloudflare_zone.main.id
      BUCKET        = cloudflare_r2_bucket.mesh_agents_cache.name
      DOMAIN        = local.mesh_agents_cache_domain
      LIFECYCLE     = jsonencode(local.mesh_agents_cache_lifecycle)
    }
    command = <<-EOT
      api="https://api.cloudflare.com/client/v4/accounts/$CF_ACCOUNT_ID/r2/buckets/$BUCKET"
      auth=(-H "Authorization: Bearer $CF_API_TOKEN" -H "Content-Type: application/json")

      if curl -fsS "$${auth[@]}" "$api/domains/custom" |
        jq -e --arg d "$DOMAIN" '.result.domains[] | select(.domain == $d)' >/dev/null; then
        echo "$BUCKET: $DOMAIN already attached"
      else
        curl -fsS -X POST "$${auth[@]}" "$api/domains/custom" \
          --data "$(jq -n --arg d "$DOMAIN" --arg z "$ZONE_ID" \
            '{domain: $d, zoneId: $z, enabled: true, minTLS: "1.2"}')" |
          jq -e '.success' >/dev/null
        echo "$BUCKET: $DOMAIN attached"
      fi

      curl -fsS -X PUT "$${auth[@]}" "$api/lifecycle" --data "$LIFECYCLE" | jq -e '.success' >/dev/null
      echo "$BUCKET: lifecycle rules applied"
    EOT
  }
}

# Cloudflare caches only known static extensions by default; .narinfo and
# nar/* aren't among them. Store paths are content-addressed, so a file under
# a name never changes: cache everything for 30 days at the edge. Misses (404)
# only for a minute, so a fresh push shows up quickly.
#
# The zone's only http_request_cache_settings ruleset: further cache rules go
# here as more rules.
resource "cloudflare_ruleset" "cache_settings" {
  zone_id     = data.cloudflare_zone.main.id
  name        = "Cache settings"
  description = "Cache rules for kleinbem.dev"
  kind        = "zone"
  phase       = "http_request_cache_settings"

  rules {
    description = "mesh-agents binary cache: content-addressed, cache at the edge"
    expression  = "(http.host eq \"${local.mesh_agents_cache_domain}\")"
    action      = "set_cache_settings"
    enabled     = true

    action_parameters {
      cache = true

      edge_ttl {
        mode    = "override_origin"
        default = 30 * 86400

        status_code_ttl {
          status_code = 404
          value       = 60
        }
      }

      browser_ttl {
        mode = "respect_origin"
      }
    }
  }
}
